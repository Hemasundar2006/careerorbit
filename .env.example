# Copy this file to .env and provide your own values. Never commit .env.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/opportunity_hub
# Optional: set a DNS resolver if your network cannot resolve MongoDB SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password-for-setup-only
PORT=4000
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_SITE_NAME=CareerOrbit
